### Проверим 404
GET http://localhost:8080/api/films/999999

@Test
void createFilmWithoutTitle_shouldReturn400() {

    String requestBody = """
            {
                "year": 2020,
                "rating": 8.0,
                "genre": "Фантастика"
            }
            """;

    given()
            .contentType(ContentType.JSON)
            .body(requestBody)
            .when()
            .post("/api/films")
            .then()
            .statusCode(400);
}

@Test
void createFilmWithoutYear_shouldReturn400() {

    String requestBody = """
            {
                "title": "Фильм без года",
                "rating": 8.0,
                "genre": "Драма"
            }
            """;

    given()
            .contentType(ContentType.JSON)
            .body(requestBody)
            .when()
            .post("/api/films")
            .then()
            .statusCode(400);
}

@Test
void createFilmWithInvalidRating_shouldReturn400() {

    String requestBody = """
            {
                "title": "Фильм с неправильным рейтингом",
                "year": 2020,
                "rating": 15.0,
                "genre": "Драма"
            }
            """;

    given()
            .contentType(ContentType.JSON)
            .body(requestBody)
            .when()
            .post("/api/films")
            .then()
            .statusCode(400);
}

@Test
void createFilmWithInvalidYear_shouldReturn400() {

    String requestBody = """
            {
                "title": "Очень старый фильм",
                "year": 1500,
                "rating": 8.0,
                "genre": "Драма"
            }
            """;

    given()
            .contentType(ContentType.JSON)
            .body(requestBody)
            .when()
            .post("/api/films")
            .then()
            .statusCode(400);
}

